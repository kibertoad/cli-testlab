{
  "name": "cli-testlab",
  "version": "6.0.1",
  "description": "Test framework for CLI utilities",
  "author": {
    "name": "Igor Savin",
    "web": "https://github.com/kibertoad"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "del-cli dist/ && tsc && copyfiles test/util/apps/*.js dist",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "npm run lint && npm run test:coverage",
    "lint": "oxlint \"lib/**/*.ts\" \"test/**/*.ts\" \"test/**/*.js\" index.ts && oxfmt --check \"{lib,test}/**/*.{js,ts}\" index.ts",
    "lint:fix": "oxlint --fix \"lib/**/*.ts\" \"test/**/*.ts\" \"test/**/*.js\" index.ts && oxfmt --write \"{lib,test}/**/*.{js,ts}\" index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/kibertoad/cli-testlab.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "commander": "^15.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/lib/*",
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "keywords": [
    "cli",
    "test",
    "tests",
    "testing",
    "framework",
    "commandline",
    "terminal"
  ]
}
